# 本地开发环境变量示例。复制为 configs/.env 后再修改真实值。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=app_db
REDIS_ADDR=127.0.0.1:6379

# HTTP_ADDR / GRPC_ADDR 优先于 YAML；仅本机开发默认监听本机。
HTTP_ADDR=127.0.0.1:10006
GRPC_ADDR=127.0.0.1:11006
# 生成至少 32 字节的随机密钥，不要使用此占位值。
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES
AUTH_TTL_HOURS=168
# 本地 HTTP 为 false；正式 HTTPS 必须 true（程序默认 true）。
COOKIE_SECURE=false
# 同源代理无需配置。跨域开发才填写明确来源，逗号分隔，禁止 *。
ALLOWED_ORIGINS=
# INIT_USERNAME / INIT_PASSWORD 仅在执行 init-account 时临时设置，不写入此文件。
